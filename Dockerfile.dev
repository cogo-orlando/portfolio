# ══════════════════════════════════════════
#  DOCKERFILE DEV — Hot reload avec Air
#  Ne jamais utiliser en production
# ══════════════════════════════════════════
FROM golang:1.27-alpine

WORKDIR /app

# Air, version épinglée
RUN go install github.com/air-verse/air@v1.61.7

COPY go.mod go.sum ./
RUN go mod download

# Le code est monté via le volume de docker-compose.dev.yml

ENV PORT=8080 \
    TZ=Europe/Paris \
    GO_ENV=development

EXPOSE 8080

CMD ["air"]