# ══════════════════════════════════════════
#  .dockerignore
#  Exclut du build tout ce qui n'est pas nécessaire (et les secrets)
# ══════════════════════════════════════════

# Git & CI
.git
.gitignore
.github/

# Documentation
*.md

# Secrets et environnement local
.env
.env.*
!.env.example

# Air (hot-reload dev)
tmp/
.air.toml

# Docker
Dockerfile*
docker-compose*
.dockerignore

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Tests, couverture, scripts
*_test.go
testdata/
*.out
coverage.*
scripts/

# Schéma SQL (exécuté dans Supabase, pas utile au serveur)
*.sql

# Données locales
data/